---
import { Picture } from "astro:assets";
import type { LocaleContent } from "../data/content";
import { siteAssets, siteConfig } from "../data/site";

interface Props {
  copy: LocaleContent;
}

const { copy } = Astro.props;
---

<section id="home" class="page-section hero-section" data-section="home">
  <div class="section-shell hero-shell">
    <div class="section-orbit-lines" aria-hidden="true">
      <span></span>
      <span></span>
    </div>
    <div class="hero-copy">
      <h1 class="hero-name" data-hero-line aria-label={siteConfig.name}>
        <span>Thomas</span>
        <span>Luizon</span>
      </h1>
      <p class="hero-role" data-copy="hero.eyebrow" data-hero-line>{copy.hero.eyebrow}</p>
      <p class="hero-summary" data-copy="hero.summary" data-hero-line>
        {copy.hero.summary}
      </p>

      <div class="hero-actions" data-hero-line>
        <a href="#orbit" class="action-button action-button--primary" data-copy="hero.secondaryCta">
          <span>{copy.hero.secondaryCta}</span>
        </a>
        <a href="#contact" class="action-button" data-copy="hero.primaryCta">
          <span>{copy.hero.primaryCta}</span>
        </a>
        <a href={siteConfig.github} class="action-button action-button--icon" target="_blank" rel="noreferrer" aria-label="GitHub">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 2C6.48 2 2 6.58 2 12.23c0 4.52 2.87 8.35 6.84 9.7.5.1.68-.22.68-.49 0-.24-.01-.88-.01-1.73-2.78.62-3.37-1.37-3.37-1.37-.45-1.18-1.11-1.49-1.11-1.49-.91-.64.07-.63.07-.63 1 .07 1.53 1.06 1.53 1.06.9 1.57 2.35 1.12 2.92.85.09-.67.35-1.12.63-1.38-2.22-.26-4.56-1.14-4.56-5.06 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.28 2.75 1.05A9.31 9.31 0 0 1 12 6.94c.85 0 1.7.12 2.5.34 1.9-1.33 2.74-1.05 2.74-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.93-2.34 4.8-4.57 5.05.36.32.68.95.68 1.92 0 1.38-.01 2.5-.01 2.84 0 .27.18.6.69.49A10.1 10.1 0 0 0 22 12.23C22 6.58 17.52 2 12 2Z" />
          </svg>
        </a>
      </div>
    </div>

    <div class="hero-portrait" data-hero-line>
      <div class="hero-portrait__ring" aria-hidden="true"></div>
      <div class="hero-portrait__image-wrap">
        <Picture
          src={siteAssets.profile}
          alt="Thomas Luizon"
          formats={["avif", "webp"]}
          widths={[280, 420, 560, 720]}
          sizes="(min-width: 64rem) 20rem, 66vw"
          priority
          class="hero-portrait__image"
        />
      </div>
    </div>
  </div>
</section>
