---
import { Image, Picture } from "astro:assets";
import type { LocaleContent } from "../data/content";
import { orbitCaseStudy } from "../data/site";

interface Props {
  copy: LocaleContent;
}

const { copy } = Astro.props;
const orbit = orbitCaseStudy;
---

<section id="orbit" class="page-section orbit-section" data-section="orbit">
  <div class="section-shell orbit-case">
    <div class="orbit-copy" data-reveal>
      <div class="orbit-profile">
        <Image src={orbit.assets.logo} alt="" class="orbit-logo" aria-hidden="true" />
        <span data-copy="orbit.roleValue">{copy.orbit.roleValue}</span>
      </div>

      <h2 class="orbit-title" data-copy="orbit.title">{copy.orbit.title}</h2>
      <p class="orbit-subtitle" data-copy="orbit.subtitle">{copy.orbit.subtitle}</p>
      <p class="orbit-intro" data-copy="orbit.intro">{copy.orbit.intro}</p>

      <div class="orbit-actions">
        <a
          href={orbit.url}
          class="action-button action-button--primary"
          target="_blank"
          rel="noreferrer"
          data-copy="orbit.links.website"
        >
          {copy.orbit.links.website}
        </a>
        <a
          href={orbit.appUrl}
          class="action-button"
          target="_blank"
          rel="noreferrer"
          data-copy="orbit.links.app"
        >
          {copy.orbit.links.app}
        </a>
      </div>
    </div>

    <div class="orbit-product" data-reveal>
      <div class="orbit-visual-layer" aria-hidden="true">
        <div class="orbital-ring orbital-ring--one"></div>
        <div class="orbital-ring orbital-ring--two"></div>
      </div>

      <div class="orbit-phone-stage" aria-label="Real Orbit app screens">
        <div class="orbit-phone-glow" aria-hidden="true"></div>
        <div class="orbit-phone-device">
          <div class="orbit-phone-notch" aria-hidden="true"></div>
          <div class="orbit-screen-carousel">
            {
              orbit.assets.screens.map((screen, index) => (
                <Picture
                  src={screen.image}
                  alt={index === 0 ? "Real Orbit app screen" : ""}
                  formats={["avif", "webp"]}
                  widths={[220, 300, 420, 560]}
                  sizes="(min-width: 64rem) 12.75rem, 54vw"
                  class="orbit-screen__image"
                  pictureAttributes={{ class: `orbit-screen orbit-screen--${index + 1}` }}
                />
              ))
            }
          </div>
        </div>
        <div class="orbit-screen-track" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
          <span></span>
        </div>
      </div>
    </div>
  </div>
</section>
