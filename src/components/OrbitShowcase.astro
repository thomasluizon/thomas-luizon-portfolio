---
import { Image, Picture } from "astro:assets";
import type { LocaleContent } from "../data/content";
import { orbitCaseStudy } from "../data/site";

interface Props {
  copy: LocaleContent;
}

const { copy } = Astro.props;
const orbit = orbitCaseStudy;
---

<section id="orbit" class="page-section orbit-section" data-section="orbit">
  <div class="section-shell">
    <article class="orbit-capsule">
      <header class="oc-head" data-reveal>
        <span class="oc-eyebrow" data-copy="orbit.label">{copy.orbit.label}</span>
        <span class="oc-role" data-copy="orbit.roleValue">{copy.orbit.roleValue}</span>
      </header>

      <div class="oc-hero">
        <div class="oc-hero-copy" data-reveal>
          <h2 class="oc-title"><Image src={orbit.assets.logo} alt="Orbit" class="oc-logo" /></h2>
          <p class="oc-subtitle" data-copy="orbit.subtitle">{copy.orbit.subtitle}</p>
          <p class="oc-intro" data-copy="orbit.intro">{copy.orbit.intro}</p>
          <div class="oc-actions">
            <a href={orbit.playStoreUrl} class="oc-cta oc-cta--primary" target="_blank" rel="noreferrer" data-copy="orbit.links.play">
              {copy.orbit.links.play}
            </a>
            <a href={orbit.appUrl} class="oc-cta oc-cta--ghost" target="_blank" rel="noreferrer" data-copy="orbit.links.app">
              {copy.orbit.links.app}
            </a>
            <a href={orbit.url} class="oc-link" target="_blank" rel="noreferrer" data-copy="orbit.links.website">
              {copy.orbit.links.website}
            </a>
          </div>
        </div>

        <figure class="oc-product" data-reveal>
          <Picture
            src={orbit.assets.preview}
            alt={copy.orbit.previewAlt}
            data-copy-alt="orbit.previewAlt"
            formats={["avif", "webp"]}
            widths={[260, 390, 520, 780]}
            sizes="(min-width: 52rem) 15rem, 65vw"
            class="oc-preview-image"
          />
          <figcaption data-copy="orbit.previewCaption">{copy.orbit.previewCaption}</figcaption>
        </figure>
      </div>

      <ul class="oc-pillars">
        {copy.orbit.pillars.map((pillar, index) => (
          <li class="oc-pillar">
            <span class="oc-pillar-label" data-copy={`orbit.pillars.${index}.label`}>{pillar.label}</span>
            <h3 class="oc-pillar-title" data-copy={`orbit.pillars.${index}.title`}>{pillar.title}</h3>
            <p class="oc-pillar-body" data-copy={`orbit.pillars.${index}.body`}>{pillar.body}</p>
          </li>
        ))}
      </ul>

      <div class="oc-stack">
        <span class="oc-stack-label" data-copy="orbit.stackLabel">{copy.orbit.stackLabel}</span>
        <ul class="oc-stack-chips">
          {orbit.stack.map((item) => <li class="oc-chip">{item}</li>)}
        </ul>
      </div>
    </article>
  </div>
</section>
