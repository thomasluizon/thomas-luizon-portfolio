---
import { defaultLocale } from "../data/content";

const initialLabel = defaultLocale === "pt-BR" ? "PT" : "EN";
---

<button
  class="lang-toggle"
  type="button"
  data-locale-toggle
  data-copy-aria="nav.languageLabel"
  aria-label="Switch language"
>
  <span class="lang-toggle__label" data-locale-display>{initialLabel}</span>
</button>
