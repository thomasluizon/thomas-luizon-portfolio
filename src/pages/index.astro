---
import { Picture } from "astro:assets";
import ContactForm from "../components/ContactForm.astro";
import LanguageSwitcher from "../components/LanguageSwitcher.astro";
import OrbitShowcase from "../components/OrbitShowcase.astro";
import SocialLinks from "../components/SocialLinks.astro";
import { content, defaultLocale } from "../data/content";
import { siteAssets, siteConfig } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";

const copy = content[defaultLocale];
const navItems = [
  { href: "#about", id: "about", key: "nav.about", label: copy.nav.about },
  {
    href: "#principles",
    id: "principles",
    key: "nav.principles",
    label: copy.nav.principles,
  },
  { href: "#orbit", id: "orbit", key: "nav.orbit", label: copy.nav.orbit },
  { href: "#contact", id: "contact", key: "nav.contact", label: copy.nav.contact },
];
---

<BaseLayout title={copy.meta.title} description={copy.meta.description}>
  <a href="#main-content" class="skip-link">Skip to content</a>

  <header class="site-header" data-site-header>
    <div class="site-header__inner">
      <a href="#home" class="brand-mark" aria-label="Thomas Luizon home">
        <span class="brand-mark__name">{siteConfig.name}</span>
        <span class="brand-mark__role">{siteConfig.role}</span>
      </a>

      <nav class="site-nav" aria-label="Primary">
        {
          navItems.map((item) => (
            <a href={item.href} data-nav-link={item.id} data-copy={item.key}>
              {item.label}
            </a>
          ))
        }
      </nav>

      <div class="site-header__actions">
        <SocialLinks className="site-header__socials" />
        <LanguageSwitcher />
        <a href="#contact" class="header-cta" data-copy="nav.workTogether">
          {copy.nav.workTogether}
        </a>
        <button
          class="menu-toggle"
          type="button"
          data-menu-toggle
          aria-expanded="false"
          data-copy-aria="nav.menu"
          aria-label={copy.nav.menu}
        >
          <span data-menu-label data-copy="nav.menu">{copy.nav.menu}</span>
        </button>
      </div>
    </div>
    <div class="site-progress" aria-hidden="true">
      <span data-scroll-progress></span>
    </div>
  </header>

  <div class="mobile-nav" data-mobile-nav hidden>
    <nav class="mobile-nav__panel" aria-label="Mobile">
      {
        navItems.map((item) => (
          <a href={item.href} data-copy={item.key}>
            {item.label}
          </a>
        ))
      }
      <SocialLinks includeEmail={true} className="mobile-nav__socials" />
    </nav>
  </div>

  <main id="main-content">
    <section id="home" class="page-section hero-section" data-section="home">
      <div class="section-shell hero-shell">
        <div class="hero-copy">
          <div class="hero-profile" data-hero-line>
            <Picture
              src={siteAssets.profile}
              alt="Thomas Luizon"
              formats={["avif", "webp"]}
              widths={[96, 160, 240]}
              sizes="5rem"
              priority
              class="hero-avatar__image"
              pictureAttributes={{ class: "hero-avatar" }}
            />
            <span class="hero-role" data-copy="hero.eyebrow">{copy.hero.eyebrow}</span>
          </div>
          <p class="hero-name" data-hero-line>{siteConfig.name}</p>
          <h1 class="hero-title" data-copy="hero.title" data-hero-line>{copy.hero.title}</h1>
          <p class="hero-summary" data-copy="hero.summary" data-hero-line>
            {copy.hero.summary}
          </p>

          <div class="hero-actions" data-hero-line>
            <a href="#contact" class="action-button action-button--primary" data-copy="hero.primaryCta">
              {copy.hero.primaryCta}
            </a>
            <a href="#orbit" class="action-button" data-copy="hero.secondaryCta">
              {copy.hero.secondaryCta}
            </a>
          </div>
        </div>
      </div>

    </section>

    <section id="about" class="page-section" data-section="about">
      <div class="section-shell about-shell">
        <div class="section-main about-copy">
          <h2 class="section-title" data-copy="about.title" data-reveal>{copy.about.title}</h2>
          <div class="text-stack">
            {
              copy.about.narrative.map((paragraph, index) => (
                <p data-copy={`about.narrative.${index}`} data-reveal>
                  {paragraph}
                </p>
              ))
            }
          </div>
        </div>

        <aside class="section-side about-tools" data-reveal>
          <p class="side-heading" data-copy="about.capabilityLabel">{copy.about.capabilityLabel}</p>
          <ul class="capability-list">
            {
              copy.about.capabilities.map((item, index) => (
                <li>
                  <span>{String(index + 1).padStart(2, "0")}</span>
                  <span data-copy={`about.capabilities.${index}`}>{item}</span>
                </li>
              ))
            }
          </ul>
        </aside>
      </div>
    </section>

    <section id="principles" class="page-section" data-section="principles">
      <div class="section-shell principles-shell">
        <div class="section-main principles-heading">
          <h2 class="section-title" data-copy="principles.title" data-reveal>
            {copy.principles.title}
          </h2>
          {copy.principles.intro && (
            <p class="section-intro" data-copy="principles.intro" data-reveal>
              {copy.principles.intro}
            </p>
          )}
        </div>

        <div class="principles-list">
          {
            copy.principles.items.map((item, index) => (
              <article class="principle-row" data-reveal>
                <span class="principle-row__index">{String(index + 1).padStart(2, "0")}</span>
                <div>
                  <h3 data-copy={`principles.items.${index}.title`}>{item.title}</h3>
                  <p data-copy={`principles.items.${index}.body`}>{item.body}</p>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <OrbitShowcase copy={copy} />

    <section id="contact" class="page-section contact-section" data-section="contact">
      <div class="section-shell split-shell contact-shell">
        <aside class="section-rail">
          <span>04</span>
          <span data-copy="contact.label">{copy.contact.label}</span>
        </aside>

        <div class="section-main contact-copy" data-reveal>
          <h2 class="section-title" data-copy="contact.title">{copy.contact.title}</h2>
          <p class="section-intro" data-copy="contact.body">{copy.contact.body}</p>
          <div class="contact-direct">
            <span data-copy="contact.emailLabel">{copy.contact.emailLabel}</span>
            <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
          </div>
          <SocialLinks includeEmail={true} className="contact-socials" />
        </div>

        <div class="contact-form-wrap" data-reveal>
          <ContactForm copy={copy} />
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="site-footer__inner">
      <p data-copy="footer.status">{copy.footer.status}</p>
      <div class="site-footer__meta">
        <span data-copy="footer.rights">{copy.footer.rights}</span>
        <span data-copy="footer.builtWith">{copy.footer.builtWith}</span>
      </div>
    </div>
  </footer>
</BaseLayout>
